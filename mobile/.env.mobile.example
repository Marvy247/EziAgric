# Expo environment variables
EXPO_PUBLIC_API_URL=http://localhost:4000
# Version prefix for consumer-facing API calls. Keep /api/v1 (versioned lane).
# Set empty (EXPO_PUBLIC_API_VERSION_PREFIX=) to use legacy aliases (deprecated).
EXPO_PUBLIC_API_VERSION_PREFIX=/api/v1
EXPO_PUBLIC_ANALYTICS_ENABLED=true

# Stellar network (testnet or public)
EXPO_PUBLIC_STELLAR_NETWORK=testnet

# Push notifications
EXPO_PUBLIC_PUSH_PROVIDER=expo

# Crash / ANR reporting (see docs/crash-reporting.md)
# Self-host intake endpoint (backend POST /crash-reports). Leave empty in dev.
EXPO_PUBLIC_CRASH_INGEST_URL=
# Optional Sentry DSN — enables the Sentry transport in addition to intake.
EXPO_PUBLIC_SENTRY_DSN=
# Release identifier attached to every crash report (set by CI on release builds).
EXPO_PUBLIC_CRASH_RELEASE=
EXPO_PUBLIC_APP_VERSION=0.1.0
